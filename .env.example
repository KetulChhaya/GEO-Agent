# Postgres (used both for container init and to assemble DATABASE_URL below)
POSTGRES_USER=citesight
POSTGRES_PASSWORD=citesight
POSTGRES_DB=citesight

# Host-side DATABASE_URL for running alembic/pytest directly on the host.
# docker-compose publishes the postgres container on 5433 (5432 is already
# taken by a local, non-Docker Postgres on this machine); containers talk to
# each other over the compose network using postgres:5432 regardless.
DATABASE_URL=postgresql+asyncpg://citesight:citesight@localhost:5433/citesight

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

MAX_PAGES=30
MAX_QUERIES=15
TOKEN_BUDGET=150000

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=audits
